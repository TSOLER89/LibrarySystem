@page "/books/new"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using LibrarySystem.Core.Models
@inject LibrarySystem.Web.Services.BookService BookService
@inject NavigationManager Nav

<h3>➕ Lägg till ny bok</h3>

<EditForm Model="model" OnValidSubmit="HandleValidSubmit" FormName="NewBookForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label for="isbn">ISBN</label>
        <InputText id="isbn" class="form-control" @bind-Value="model.ISBN" />
        <ValidationMessage For="@(() => model.ISBN)" />
        <small class="text-muted">Skriv 10 eller 13 siffror (t.ex. 9780451524935)</small>
    </div>

    <div class="mb-3">
        <label for="title">Titel</label>
        <InputText id="title" class="form-control" @bind-Value="model.Title" />
        <ValidationMessage For="@(() => model.Title)" />
    </div>

    <div class="mb-3">
        <label for="author">Författare</label>
        <InputText id="author" class="form-control" @bind-Value="model.Author" />
        <ValidationMessage For="@(() => model.Author)" />
    </div>

    <div class="mb-3">
        <label for="year">Publiceringsår</label>
        <InputNumber id="year" class="form-control" @bind-Value="model.PublishedYear" />
        <ValidationMessage For="@(() => model.PublishedYear)" />
    </div>

    <button class="btn btn-primary" type="submit">Spara</button>
    <a class="btn btn-link" href="/books">Avbryt</a>
</EditForm>

@code {
    private NewBookModel model = new();

    private async Task HandleValidSubmit()
    {
        // Skapa en riktig Book och spara i DB
        var book = new Book
        {
            ISBN = model.ISBN.Trim(),
            Title = model.Title.Trim(),
            Author = model.Author.Trim(),
            PublishedYear = model.PublishedYear,
            IsAvailable = true
        };

        await BookService.AddAsync(book);
        Nav.NavigateTo("/books", forceLoad: true);
    }

    private class NewBookModel
    {
        [Required(ErrorMessage = "ISBN måste fyllas 10/13 siffror")]
        [RegularExpression(@"^(?:\d{10}|\d{13})$", ErrorMessage = "ISBN måste vara 10 eller 13 siffror")]
        public string ISBN { get; set; } = "";

        [Required(ErrorMessage = "Titel måste fyllas i")]
        public string Title { get; set; } = "";

        [Required(ErrorMessage = "Författare måste fyllas i")]
        public string Author { get; set; } = "";

        [Range(1450, 2100, ErrorMessage = "År måste vara mellan 1450 och 2100")]
        public int PublishedYear { get; set; } = DateTime.Now.Year;
    }
}