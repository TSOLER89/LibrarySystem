@page "/books"
@using LibrarySystem.Core.Models
@inject LibrarySystem.Web.Services.BookService Books

<h3>📚 Boklista</h3>

<div style="margin-bottom: 12px;">
    <input placeholder="Sök på titel, författare eller ISBN..."
           @bind="searchTerm" @bind:event="oninput" />
    <button @onclick="DoSearch">Sök</button>
    <a href="/books/new" style="margin-left: 12px;">+ Lägg till bok</a>
</div>

@if (items is null)
{
    <p>Laddar...</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th><button @onclick="() => SortBy(nameof(Book.ISBN))">ISBN</button></th>
                <th><button @onclick="() => SortBy(nameof(Book.Title))">Titel</button></th>
                <th><button @onclick="() => SortBy(nameof(Book.Author))">Författare</button></th>
                <th><button @onclick="() => SortBy(nameof(Book.PublishedYear))">År</button></th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in items)
            {
                <tr>
                    <td>@b.ISBN</td>
                    <td>@b.Title</td>
                    <td>@b.Author</td>
                    <td>@b.PublishedYear</td>
                    <td>@(b.IsAvailable ? "🟢 Tillgänglig" : "🔴 Utlånad")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Book>? items;
    private string searchTerm = "";
    private string sortColumn = nameof(Book.Title);
    private bool sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        items = (await Books.GetAllAsync()).ToList();
        ApplySort();
    }

    private async Task DoSearch()
    {
        items = (await Books.SearchAsync(searchTerm)).ToList();
        ApplySort();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAsc = !sortAsc;
        else
        {
            sortColumn = column;
            sortAsc = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        if (items is null) return;

        items = sortColumn switch
        {
            nameof(Book.ISBN) => sortAsc ? items.OrderBy(b => b.ISBN).ToList()
                                        : items.OrderByDescending(b => b.ISBN).ToList(),

            nameof(Book.Title) => sortAsc ? items.OrderBy(b => b.Title).ToList()
                                          : items.OrderByDescending(b => b.Title).ToList(),

            nameof(Book.Author) => sortAsc ? items.OrderBy(b => b.Author).ToList()
                                           : items.OrderByDescending(b => b.Author).ToList(),

            nameof(Book.PublishedYear) => sortAsc ? items.OrderBy(b => b.PublishedYear).ToList()
                                                  : items.OrderByDescending(b => b.PublishedYear).ToList(),

            _ => items
        };
    }
}