@page "/books"
@rendermode InteractiveServer
@using LibrarySystem.Core.Models
@inject LibrarySystem.Web.Services.BookService BookService

<h3>📚 Boklista</h3>

<div class="mb-3 d-flex flex-wrap gap-2 align-items-center">
    <input class="form-control"
           style="max-width: 420px;"
           placeholder="Sök på titel, författare eller ISBN..."
           value="@searchTerm"
           @oninput="HandleSearchInput" />

    <button class="btn btn-outline-secondary" type="button" @onclick="ClearSearch">
        Rensa
    </button>

    <a class="btn btn-success ms-md-auto" href="/books/new">
        + Lägg till bok
    </a>
</div>

@if (items is null)
{
    <p>Laddar...</p>
}
else if (items.Count == 0)
{
    <div class="alert alert-info">
        Inga böcker hittades.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>
                        <button class="btn btn-link p-0 text-decoration-none" type="button" @onclick="() => SortBy(nameof(Book.ISBN))">
                            ISBN @SortIndicator(nameof(Book.ISBN))
                        </button>
                    </th>

                    <th>
                        <button class="btn btn-link p-0 text-decoration-none" type="button" @onclick="() => SortBy(nameof(Book.Title))">
                            Titel @SortIndicator(nameof(Book.Title))
                        </button>
                    </th>

                    <th>
                        <button class="btn btn-link p-0 text-decoration-none" type="button" @onclick="() => SortBy(nameof(Book.Author))">
                            Författare @SortIndicator(nameof(Book.Author))
                        </button>
                    </th>

                    <th>
                        <button class="btn btn-link p-0 text-decoration-none" type="button" @onclick="() => SortBy(nameof(Book.PublishedYear))">
                            År @SortIndicator(nameof(Book.PublishedYear))
                        </button>
                    </th>

                    <th>Status</th>
                    <th style="min-width: 220px;">Åtgärder</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var book in items)
                {
                    <tr>
                        <td>@book.ISBN</td>
                        <td>@book.Title</td>
                        <td>@book.Author</td>
                        <td>@book.PublishedYear</td>

                        <td>
                            @if (book.IsAvailable)
                            {
                                <span class="badge bg-success">Tillgänglig</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Utlånad</span>
                            }
                        </td>

                        <td class="d-flex flex-wrap gap-2">
                            <a class="btn btn-sm btn-outline-primary" href="@($"/books/{book.Id}")">
                                Detaljer
                            </a>

                            <a class="btn btn-sm btn-outline-secondary" href="@($"/books/edit/{book.Id}")">
                                Edit
                            </a>

                            <button class="btn btn-sm btn-danger"
                                    type="button"
                                    @onclick="() => DeleteBook(book.Id)">
                                Ta bort
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<Book>? items;
    private string searchTerm = "";
    private string sortColumn = nameof(Book.Title);
    private bool sortAsc = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadAll();
    }

    private async Task LoadAll()
    {
        items = (await BookService.GetAllAsync()).ToList();
        ApplySort();
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        items = (await BookService.SearchAsync(searchTerm)).ToList();
        ApplySort();
    }

    private async Task ClearSearch()
    {
        searchTerm = "";
        await LoadAll();
    }

    private async Task DeleteBook(int id)
    {
        await BookService.DeleteAsync(id);
        await LoadAll();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
        {
            sortAsc = !sortAsc;
        }
        else
        {
            sortColumn = column;
            sortAsc = true;
        }

        ApplySort();
    }

    private void ApplySort()
    {
        if (items is null) return;

        items = sortColumn switch
        {
            nameof(Book.ISBN) => sortAsc
                ? items.OrderBy(b => b.ISBN).ToList()
                : items.OrderByDescending(b => b.ISBN).ToList(),

            nameof(Book.Title) => sortAsc
                ? items.OrderBy(b => b.Title).ToList()
                : items.OrderByDescending(b => b.Title).ToList(),

            nameof(Book.Author) => sortAsc
                ? items.OrderBy(b => b.Author).ToList()
                : items.OrderByDescending(b => b.Author).ToList(),

            nameof(Book.PublishedYear) => sortAsc
                ? items.OrderBy(b => b.PublishedYear).ToList()
                : items.OrderByDescending(b => b.PublishedYear).ToList(),

            _ => items
        };
    }

    private string SortIndicator(string column)
    {
        if (sortColumn != column)
            return "";

        return sortAsc ? "▲" : "▼";
    }
}